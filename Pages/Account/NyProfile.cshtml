@page
@model Movies.Pages.Account.MyProfileModel
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <h2>My Profile</h2>

    <ul class="nav nav-tabs mb-3" id="profileTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">Profile Info</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="watchlist-tab" data-bs-toggle="tab" data-bs-target="#watchlist" type="button" role="tab">Watchlist (@Model.Watchlist.Count)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="liked-tab" data-bs-toggle="tab" data-bs-target="#liked" type="button" role="tab">Liked Movies (@Model.LikedMovies.Count)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="watched-tab" data-bs-toggle="tab" data-bs-target="#watched" type="button" role="tab">Watched Movies (@Model.WatchedMovies.Count)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="awards-tab" data-bs-toggle="tab" data-bs-target="#awards" type="button" role="tab">Awards (@Model.Awards.Count)</button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Profile Info -->
        <div class="tab-pane fade show active" id="info" role="tabpanel">
            <dl class="row">
                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">@Model.CurrentUser.UserName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.CurrentUser.Email</dd>

                <dt class="col-sm-3">XP</dt>
                <dd class="col-sm-9">@((Model.Progress?.XP) ?? 0)</dd>

                <dt class="col-sm-3">Level</dt>
                <dd class="col-sm-9">@((Model.Progress?.Level) ?? 1)</dd>
            </dl>
        </div>

        <!-- Watchlist -->
        <div class="tab-pane fade" id="watchlist" role="tabpanel">
            <div class="row row-cols-2 row-cols-md-4 g-3">
                @foreach (var movie in Model.Watchlist)
                {
                    <div class="col">
                        <div class="card h-100">
                            <img src="@(string.IsNullOrEmpty(movie.ImagePath) ? "/images/movies/default.jpg" : movie.ImagePath)" class="card-img-top" style="height:200px; object-fit:cover" />
                            <div class="card-body">
                                <h6 class="card-title">@movie.Title</h6>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Liked Movies -->
        <div class="tab-pane fade" id="liked" role="tabpanel">
            <div class="row row-cols-2 row-cols-md-4 g-3">
                @foreach (var movie in Model.LikedMovies)
                {
                    <div class="col">
                        <div class="card h-100">
                            <img src="@(string.IsNullOrEmpty(movie.ImagePath) ? "/images/movies/default.jpg" : movie.ImagePath)" class="card-img-top" style="height:200px; object-fit:cover" />
                            <div class="card-body">
                                <h6 class="card-title">@movie.Title</h6>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Watched Movies -->
        <div class="tab-pane fade" id="watched" role="tabpanel">
            <div class="row row-cols-2 row-cols-md-4 g-3">
                @foreach (var movie in Model.WatchedMovies)
                {
                    <div class="col">
                        <div class="card h-100">
                            <img src="@(string.IsNullOrEmpty(movie.ImagePath) ? "/images/movies/default.jpg" : movie.ImagePath)" class="card-img-top" style="height:200px; object-fit:cover" />
                            <div class="card-body">
                                <h6 class="card-title">@movie.Title</h6>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Awards -->
        <div class="tab-pane fade" id="awards" role="tabpanel">
            <div class="row row-cols-2 row-cols-md-4 g-3">
                @foreach (var award in Model.Awards)
                {
                    <div class="col">
                        <div class="card text-center h-100 p-2">
                            <img src="@award.IconUrl" class="card-img-top mx-auto" style="height:80px; width:auto; object-fit:contain;" />
                            <div class="card-body">
                                <h6 class="card-title">@award.Name</h6>
                                <p class="card-text">@award.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
