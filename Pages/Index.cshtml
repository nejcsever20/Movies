@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Header section -->
<div style="text-align: center; background-color: black; color: white; padding: 20px;">
    <h1 style="font-size: 50px; margin: 0;">Netflix</h1>
    <div style="margin-top: 10px;">
        <a href="/Identity/Account/Login" style="color: white; text-decoration: none; margin-right: 20px; font-weight: bold;">Login</a>
        <a href="/Identity/Account/Register" style="color: white; text-decoration: none; font-weight: bold;">Register</a>
    </div>
</div>

<!-- Main hero section -->
<div style="text-align: center; margin-top: 100px;">
    <h1 style="font-size: 60px; font-weight: bold;">Unlimited Movies, TV Shows, and More</h1>
    <p style="font-size: 24px;">Watch anywhere. Cancel anytime.</p>
    <div style="margin-top: 30px;">
        <a href="/Identity/Account/Register" style="background-color: red; color: white; padding: 15px 30px; text-decoration: none; font-size: 20px; font-weight: bold;">Get Started</a>
    </div>
</div>

<!-- Ocean waves section -->
<div class="ocean">
    <div class="wave"></div>
    <div class="wave"></div>
    <div class="wave"></div>
</div>

<!-- Footer links -->
<div style="text-align: center; margin-top: 100px; color: gray;">
    <p>Questions? Call 1-800-FAKEFLIX</p>
    <p>
        <a href="#" style="color: gray; text-decoration: none; margin-right: 10px;">FAQ</a>
        <a href="#" style="color: gray; text-decoration: none; margin-right: 10px;">Help Center</a>
        <a href="#" style="color: gray; text-decoration: none;">Terms of Use</a>
    </p>
</div>

<!-- CSS for ocean waves -->
<style>
    .ocean {
        position: fixed; /* fixes to bottom of screen */
        bottom: 0; /* stick to bottom */
        left: 0;
        width: 100%;
        height: 100px;
        overflow: hidden;
        background: #00bfff;
        z-index: 9999; /* make sure it’s on top if needed */
    }

    .wave {
        background: rgba(255, 255, 255, 0.5);
        position: absolute;
        top: -10px;
        width: 200%;
        height: 100px;
        border-radius: 100%;
        animation: wave-animation 4s infinite linear;
    }

        .wave:nth-child(2) {
            top: -15px;
            animation: wave-animation 6s infinite linear;
            opacity: 0.5;
        }

        .wave:nth-child(3) {
            top: -20px;
            animation: wave-animation 8s infinite linear;
            opacity: 0.3;
        }

    @@keyframes wave-animation {
        0%

    {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-50%);
    }

    }
</style>
