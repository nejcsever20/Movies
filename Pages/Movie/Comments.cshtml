@page "{id:int}"
@model Movies.Pages.Movie.CommentsModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Movie Comments";
}

<div class="container mt-4">
    <h3>Comments for: <span class="text-primary">@Model.Movie?.Title</span></h3>

    @* New Top-level Comment Form *@
    @if (SignInManager.IsSignedIn(User))
    {
        <form method="post" class="mb-4">
            <div class="mb-3">
                <textarea asp-for="NewComment.Content" class="form-control" rows="3" placeholder="Write your comment..."></textarea>
                <span asp-validation-for="NewComment.Content" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Post Comment</button>
        </form>
    }
    else
    {
        <p><a href="/Identity/Account/Login">Login</a> to post a comment.</p>
    }

    @* Comments List *@
    <div class="mt-4">
        @if (Model.Comments.Any())
        {
            @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <p>@comment.Content</p>
                        <small class="text-muted">
                            Posted @comment.CreatedAt.ToLocalTime() by @comment.User?.Email
                        </small>

                        <div class="mt-2">
                            <form method="post" asp-page-handler="LikeComment" class="d-inline">
                                <input type="hidden" name="commentId" value="@comment.MovieCommentId" />
                                <input type="hidden" name="isLike" value="true" />
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    👍 @Model.GetLikesCount(comment)
                                </button>
                            </form>

                            <form method="post" asp-page-handler="LikeComment" class="d-inline">
                                <input type="hidden" name="commentId" value="@comment.MovieCommentId" />
                                <input type="hidden" name="isLike" value="false" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    👎 @Model.GetDislikesCount(comment)
                                </button>
                            </form>
                        </div>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleReplyForm('@comment.MovieCommentId')">
                                    💬 Reply
                                </button>

                                <div id="replyBox-@comment.MovieCommentId" class="d-none mt-2">
                                    <form method="post" asp-page-handler="Reply">
                                        <input type="hidden" name="parentId" value="@comment.MovieCommentId" />
                                        <input type="hidden" name="id" value="@comment.MovieId" />
                                        <div class="mb-2">
                                            <textarea name="NewReply.Content" class="form-control" rows="2" placeholder="Write a reply..."></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-primary">Post</button>
                                        <button type="button" class="btn btn-sm btn-light" onclick="toggleReplyForm('@comment.MovieCommentId')">Cancel</button>
                                    </form>
                                </div>
                            </div>
                        }

                        @* Replies *@
                        @if (comment.Replies != null && comment.Replies.Any())
                        {
                            <div class="ms-4 mt-3">
                                @foreach (var reply in comment.Replies.OrderBy(r => r.CreatedAt))
                                {
                                    <div class="card mb-2">
                                        <div class="card-body">
                                            <p>@reply.Content</p>
                                            <small class="text-muted">
                                                Posted @reply.CreatedAt.ToLocalTime() by @reply.User?.Email
                                            </small>

                                            <div class="mt-2">
                                                <form method="post" asp-page-handler="LikeComment" class="d-inline">
                                                    <input type="hidden" name="commentId" value="@reply.MovieCommentId" />
                                                    <input type="hidden" name="isLike" value="true" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        👍 @Model.GetLikesCount(reply)
                                                    </button>
                                                </form>

                                                <form method="post" asp-page-handler="LikeComment" class="d-inline">
                                                    <input type="hidden" name="commentId" value="@reply.MovieCommentId" />
                                                    <input type="hidden" name="isLike" value="false" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        👎 @Model.GetDislikesCount(reply)
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No comments yet.</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleReplyForm(id) {
            const replyBox = document.getElementById(`replyBox-${id}`);
            if (replyBox) replyBox.classList.toggle("d-none");
        }
    </script>
}
