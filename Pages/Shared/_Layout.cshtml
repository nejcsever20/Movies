@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Movies</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Movies.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

    <style>
        /* ----------------------
                   GLOBAL STYLES
                -----------------------*/
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        main {
            flex: 1;
        }

        a:hover, .btn:hover {
            text-shadow: 0 0 8px rgba(0,0,0,0.2);
            transform: scale(1.02);
            transition: 0.2s ease;
        }

        /* LIGHT MODE */
        body.light-mode {
            background-color: #f8f9fa;
            color: #212529;
        }

        /* DARK MODE */
        body.dark-mode {
            background-color: #121212;
            color: #f8f9fa;
        }

        /* CUSTOM MODE - Dark text styling */
        body.custom-mode {
            --primary-color: #0C2B4E; /* Navbar */
            --secondary-color: #1A3D64;
            --accent-color: #1D546C;
            --background-color: #F4F4F4;
            --surface-color: #FFFFFF;
            --text-color: #0C2B4E; /* text */
            --muted-text: #2E3C55;
            --link-hover: #123A68;
            background: linear-gradient(145deg, #F4F4F4 0%, #A5C1D3 50%, #1D546C 100%) fixed;
            color: var(--text-color);
            min-height: 100vh;
            transition: all 0.3s ease;
        }

            body.custom-mode .container,
            body.custom-mode main,
            body.custom-mode .content-wrapper {
                background: rgba(255, 255, 255, 0.9);
                padding: 1.5rem;
                border-radius: 12px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
                color: var(--text-color);
            }

            /* Navbar */
            body.custom-mode .navbar {
                background-color: var(--primary-color) !important;
                color: #fff !important;
                box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.2);
            }

                body.custom-mode .navbar a {
                    color: #fff !important;
                }

                    body.custom-mode .navbar a:hover {
                        color: var(--accent-color) !important;
                    }

            /* Buttons */
            body.custom-mode button,
            body.custom-mode .btn {
                background-color: var(--accent-color) !important;
                color: #fff !important;
                border: none;
                border-radius: 6px;
                transition: all 0.3s ease;
            }

                body.custom-mode button:hover,
                body.custom-mode .btn:hover {
                    background-color: var(--secondary-color) !important;
                    transform: translateY(-2px);
                }

            /* Cards */
            body.custom-mode .card {
                background-color: var(--surface-color) !important;
                color: var(--text-color) !important;
                border-radius: 10px;
                box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.05);
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

                body.custom-mode .card:hover {
                    transform: translateY(-6px);
                    box-shadow: 0px 10px 24px rgba(0, 0, 0, 0.12);
                }

            /* Inputs */
            body.custom-mode input,
            body.custom-mode textarea,
            body.custom-mode select {
                background-color: #fff !important;
                color: var(--text-color) !important;
                border: 1px solid var(--secondary-color) !important;
                border-radius: 6px;
                transition: border-color 0.3s ease;
            }

                body.custom-mode input:focus,
                body.custom-mode textarea:focus,
                body.custom-mode select:focus {
                    border-color: var(--accent-color) !important;
                    box-shadow: 0 0 0 0.25rem rgba(29, 84, 108, 0.25);
                }

            /* Footer */
            body.custom-mode footer {
                background-color: var(--primary-color) !important;
                color: #fff !important;
                padding: 1em 0;
                text-align: center;
                box-shadow: 0px -2px 6px rgba(0, 0, 0, 0.2);
            }

            /* Pagination & Modals */
            body.custom-mode .pagination .page-item.active .page-link {
                background-color: var(--accent-color) !important;
                color: #fff !important;
            }

            body.custom-mode .modal-content {
                background-color: #fff !important;
                color: var(--text-color) !important;
                border-radius: 10px;
            }

        /* Dropdown submenu */
        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu > .dropdown-menu {
                top: 0;
                left: 100%;
                margin-left: 0;
                margin-right: 0;
            }

            .dropdown-submenu:hover > .dropdown-menu {
                display: block;
            }

    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-area="" asp-page="/Index">🎬 Movies</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Movie/Index">Movies</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Movie/Genres">Genres</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Movie/Trailers">Trailers</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Actors/Actors">Actors</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Dashboard/Dashboard">Dashboard</a></li>
                    </ul>

                    <!-- LOGIN / REGISTER OR USER DROPDOWN -->
                    <ul class="navbar-nav align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            var userName = await UserManager.GetUserNameAsync(user);

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Hello, @userName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" asp-page="/Account/EditProfile">Edit Account</a></li>
                                    <li><a class="dropdown-item" asp-page="/Account/NyProfile">My Profile</a>"</li>

                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Watchlist</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" asp-page="/Watchlist/Watchlist">My Watchlist</a></li>
                                            <li><a class="dropdown-item" asp-page="/Watchlist/PlannedWatchlist">Planned Watchlist</a></li>
                                            <li><a class="dropdown-item" asp-page="/Watchlist/Recommendations">Recommendations</a></li>
                                        </ul>
                                    </li>

                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Friends</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" asp-page="/Friends/Index">Add Friends</a></li>
                                            <li><a class="dropdown-item" asp-page="/Friends/Notifications">Notifications</a></li>
                                            <li><a class="dropdown-item" asp-page="/Friends/Chat">Private Messaging</a></li>
                                        </ul>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <button class="dropdown-item" type="button" id="themeToggle">Dark / Light Mode</button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" id="logoutForm">
                                            <button type="submit" class="dropdown-item text-danger">Logout</button>
                                        </form>
                                    </li>

                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                    <!-- END LOGIN / REGISTER OR USER DROPDOWN -->
                    <!-- Theme Selector -->
                    <li class="nav-item d-flex align-items-center ms-3">
                        <select id="themeSelect" class="form-select form-select-sm border-0 shadow-sm">
                            <option value="light">Light 🌞</option>
                            <option value="dark">Dark 🌙</option>
                            <option value="custom">Custom 🎨</option>
                        </select>
                    </li>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 container pb-5">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted text-center py-3 mt-auto">
        <div class="container">
            &copy; 2025 - Movies 🎥 - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const select = document.getElementById("themeSelect");
            const saved = localStorage.getItem("theme") || "light";
            applyTheme(saved);
            select.value = saved;

            select.addEventListener("change", function () {
                const theme = this.value;
                applyTheme(theme);
                localStorage.setItem("theme", theme);
            });
        });

        function applyTheme(theme) {
            document.body.classList.remove("light-mode", "dark-mode", "custom-mode");

            const navbar = document.querySelector(".navbar");
            const container = document.querySelector(".container");

            if (theme === "dark") {
                document.body.classList.add("dark-mode");
                if (navbar) {
                    navbar.classList.remove("navbar-light", "bg-light");
                    navbar.classList.add("navbar-dark", "bg-dark");
                }
            } else if (theme === "custom") {
                document.body.classList.add("custom-mode");
                if (navbar) {
                    navbar.classList.remove("navbar-dark", "bg-dark");
                    navbar.classList.add("navbar-light", "bg-light");
                }
            } else {
                document.body.classList.add("light-mode");
                if (navbar) {
                    navbar.classList.remove("navbar-dark", "bg-dark");
                    navbar.classList.add("navbar-light", "bg-light");
                }
            }

            // Force navbar text dark
            if (navbar) {
                navbar.querySelectorAll(".nav-link, .navbar-brand, .dropdown-item").forEach(el => el.style.color = "#fff");
            }

            // Force container text dark
            if (container) {
                container.querySelectorAll("*").forEach(el => el.style.color = "var(--text-color)");
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
